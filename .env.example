# Copia este archivo como .env y completa con tus valores reales.
SECRET_KEY=cambia-esta-clave-por-una-larga-y-secreta
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Base de datos PostgreSQL (relacional, exigida por la rúbrica)
DB_NAME=m5_adquisiciones
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=127.0.0.1
DB_PORT=5432

# --- Incremento 2 ---
# Correo (RF-27 envío de OC al proveedor). Por defecto se imprime en la consola
# del runserver; para envío real, descomenta y completa el bloque SMTP.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.tuservidor.cl
# EMAIL_PORT=587
# EMAIL_HOST_USER=adquisiciones@m5.cl
# EMAIL_HOST_PASSWORD=tu_password
# EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=adquisiciones@m5.cl

# Datos de facturación de M5 que se autocompletan en la Orden de Compra (RF-23)
EMPRESA_RAZON_SOCIAL=Constructora M5 SpA
EMPRESA_RUT=76.123.456-7
EMPRESA_GIRO=Construcción y habilitación de espacios
EMPRESA_DIRECCION=Ictinos 716, La Reina, Santiago

# Tolerancia % entre el monto de la factura y el de la(s) OC (RF-41).
FACTURA_TOLERANCIA_PCT=5
