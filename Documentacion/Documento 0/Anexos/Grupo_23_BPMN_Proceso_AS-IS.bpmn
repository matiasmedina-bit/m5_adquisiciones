<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Defs_Proc_ASIS" targetNamespace="http://grupo23.unab.cl/m5" exporter="Grupo 23" exporterVersion="1.0">
  <category id="Cat_Fase_1"><categoryValue id="CV_Fase_1" value="Generación de la necesidad"/></category>
  <category id="Cat_Fase_2"><categoryValue id="CV_Fase_2" value="Gestión de adquisiciones"/></category>
  <category id="Cat_Fase_3"><categoryValue id="CV_Fase_3" value="Recepción y verificación de materiales"/></category>
  <category id="Cat_Fase_4"><categoryValue id="CV_Fase_4" value="Gestión contable"/></category>
  <category id="Cat_Fase_5"><categoryValue id="CV_Fase_5" value="Control de inventario"/></category>
  <collaboration id="Collab_Proc_ASIS">
    <participant id="Pool_ASIS" name="Gestión de Adquisiciones e Inventario — AS-IS" processRef="Proc_ASIS"/>
  </collaboration>
  <process id="Proc_ASIS" name="Gestión de Adquisiciones e Inventario — AS-IS" isExecutable="false">
    <laneSet id="LaneSet_1">
      <lane id="Lane_JP" name="Jefe de proyecto">
        <flowNodeRef>S_Nec</flowNodeRef>
        <flowNodeRef>T_Detectar</flowNodeRef>
        <flowNodeRef>T_EnviarPedido</flowNodeRef>
        <flowNodeRef>E_CotRec</flowNodeRef>
        <flowNodeRef>T_RevEsp</flowNodeRef>
        <flowNodeRef>G_Esp</flowNodeRef>
      </lane>
      <lane id="Lane_ADQ" name="Adquisiciones">
        <flowNodeRef>T_RecibirSol</flowNodeRef>
        <flowNodeRef>SP_Cotizar</flowNodeRef>
        <flowNodeRef>G_Prov</flowNodeRef>
        <flowNodeRef>T_SelProv</flowNodeRef>
        <flowNodeRef>T_GenOC</flowNodeRef>
        <flowNodeRef>T_Correl</flowNodeRef>
        <flowNodeRef>T_GuardarOC</flowNodeRef>
      </lane>
      <lane id="Lane_CONT" name="Contabilidad">
        <flowNodeRef>T_FactRec</flowNodeRef>
        <flowNodeRef>T_Transtecnia</flowNodeRef>
        <flowNodeRef>E_FinCont</flowNodeRef>
      </lane>
      <lane id="Lane_PROV" name="Proveedor">
        <flowNodeRef>T_Atender</flowNodeRef>
        <flowNodeRef>T_EnvCot</flowNodeRef>
        <flowNodeRef>T_RecOC</flowNodeRef>
        <flowNodeRef>T_Despachar</flowNodeRef>
        <flowNodeRef>T_EnvFact</flowNodeRef>
      </lane>
      <lane id="Lane_BOD" name="Bodega">
        <flowNodeRef>T_MatRec</flowNodeRef>
        <flowNodeRef>T_Verificar</flowNodeRef>
        <flowNodeRef>G_Conforme</flowNodeRef>
        <flowNodeRef>T_Registrar</flowNodeRef>
        <flowNodeRef>E_FinBod</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="S_Nec" name="Necesidad detectada">
      <outgoing>Flow_1</outgoing>
    </startEvent>
    <userTask id="T_Detectar" name="Detectar necesidad">
      <incoming>Flow_1</incoming>
      <outgoing>Flow_2</outgoing>
    </userTask>
    <sendTask id="T_EnviarPedido" name="Enviar pedido de excel por correo">
      <incoming>Flow_2</incoming>
      <outgoing>Flow_3</outgoing>
      <property id="Prop_T_EnviarPedido" name="__targetRef_placeholder"/>
      <dataInputAssociation id="Assoc_31"><sourceRef>DS_Pedidos</sourceRef><targetRef>Prop_T_EnviarPedido</targetRef></dataInputAssociation>
      <dataInputAssociation id="Assoc_32"><sourceRef>DO_Correo</sourceRef><targetRef>Prop_T_EnviarPedido</targetRef></dataInputAssociation>
    </sendTask>
    <dataStoreReference id="DS_Pedidos" name="Pedidos - Excel" dataStoreRef="DS_DS_Pedidos"/>
    <dataObject id="DO_DO_Correo" name="Correo electrónico"/>
    <dataObjectReference id="DO_Correo" name="Correo electrónico" dataObjectRef="DO_DO_Correo"/>
    <intermediateCatchEvent id="E_CotRec" name="Cotización recibida">
      <incoming>Flow_8</incoming>
      <outgoing>Flow_9</outgoing>
      <messageEventDefinition id="MED_E_CotRec"/>
    </intermediateCatchEvent>
    <userTask id="T_RevEsp" name="Revisar especificaciones técnicas">
      <incoming>Flow_9</incoming>
      <outgoing>Flow_10</outgoing>
    </userTask>
    <exclusiveGateway id="G_Esp" name="¿Especificaciones aprobadas?">
      <incoming>Flow_10</incoming>
      <outgoing>Flow_11</outgoing>
      <outgoing>Flow_12</outgoing>
    </exclusiveGateway>
    <receiveTask id="T_RecibirSol" name="Recibir solicitud">
      <incoming>Flow_3</incoming>
      <outgoing>Flow_4</outgoing>
    </receiveTask>
    <subProcess id="SP_Cotizar" name="Cotizar con proveedores">
      <incoming>Flow_4</incoming>
      <incoming>Flow_7</incoming>
      <incoming>Flow_12</incoming>
      <incoming>Flow_15</incoming>
      <outgoing>Flow_5</outgoing>
      <outgoing>Flow_8</outgoing>
      <outgoing>Flow_13</outgoing>
    </subProcess>
    <exclusiveGateway id="G_Prov" name="Proveedor aprobado">
      <incoming>Flow_5</incoming>
      <outgoing>Flow_6</outgoing>
      <outgoing>Flow_7</outgoing>
    </exclusiveGateway>
    <userTask id="T_SelProv" name="Seleccionar proveedor">
      <incoming>Flow_6</incoming>
      <outgoing>Flow_16</outgoing>
    </userTask>
    <userTask id="T_GenOC" name="Generar OC en Excel (manual)">
      <incoming>Flow_11</incoming>
      <incoming>Flow_16</incoming>
      <outgoing>Flow_17</outgoing>
    </userTask>
    <userTask id="T_Correl" name="Asignar correlativo manual">
      <incoming>Flow_17</incoming>
      <outgoing>Flow_18</outgoing>
    </userTask>
    <userTask id="T_GuardarOC" name="Guardar OC en PDF">
      <incoming>Flow_18</incoming>
      <outgoing>Flow_19</outgoing>
      <dataOutputAssociation id="Assoc_33"><targetRef>DS_OC</targetRef></dataOutputAssociation>
    </userTask>
    <dataStoreReference id="DS_OC" name="PDF - Órdenes de compra" dataStoreRef="DS_DS_OC"/>
    <receiveTask id="T_FactRec" name="Factura recibida">
      <incoming>Flow_28</incoming>
      <outgoing>Flow_29</outgoing>
    </receiveTask>
    <userTask id="T_Transtecnia" name="Ingresar factura en Transtecnia">
      <incoming>Flow_29</incoming>
      <outgoing>Flow_30</outgoing>
      <dataOutputAssociation id="Assoc_35"><targetRef>DS_Trans</targetRef></dataOutputAssociation>
    </userTask>
    <endEvent id="E_FinCont" name="Fin">
      <incoming>Flow_30</incoming>
    </endEvent>
    <dataStoreReference id="DS_Trans" name="Sistema Transtecnia" dataStoreRef="DS_DS_Trans"/>
    <userTask id="T_Atender" name="Atender solicitud de cotización">
      <incoming>Flow_13</incoming>
      <outgoing>Flow_14</outgoing>
    </userTask>
    <sendTask id="T_EnvCot" name="Enviar cotización">
      <incoming>Flow_14</incoming>
      <outgoing>Flow_15</outgoing>
      <property id="Prop_T_EnvCot" name="__targetRef_placeholder"/>
      <dataInputAssociation id="Assoc_34"><sourceRef>DO_Cot</sourceRef><targetRef>Prop_T_EnvCot</targetRef></dataInputAssociation>
    </sendTask>
    <dataObject id="DO_DO_Cot" name="Cotización"/>
    <dataObjectReference id="DO_Cot" name="Cotización" dataObjectRef="DO_DO_Cot"/>
    <receiveTask id="T_RecOC" name="Recibir orden de compra">
      <incoming>Flow_19</incoming>
      <outgoing>Flow_20</outgoing>
    </receiveTask>
    <userTask id="T_Despachar" name="Despachar material">
      <incoming>Flow_20</incoming>
      <incoming>Flow_24</incoming>
      <outgoing>Flow_21</outgoing>
      <outgoing>Flow_27</outgoing>
    </userTask>
    <sendTask id="T_EnvFact" name="Enviar factura">
      <incoming>Flow_27</incoming>
      <outgoing>Flow_28</outgoing>
    </sendTask>
    <receiveTask id="T_MatRec" name="Material recibido">
      <incoming>Flow_21</incoming>
      <outgoing>Flow_22</outgoing>
    </receiveTask>
    <userTask id="T_Verificar" name="Verificar cantidad y calidad de material">
      <incoming>Flow_22</incoming>
      <outgoing>Flow_23</outgoing>
    </userTask>
    <exclusiveGateway id="G_Conforme" name="¿Material conforme?">
      <incoming>Flow_23</incoming>
      <outgoing>Flow_24</outgoing>
      <outgoing>Flow_25</outgoing>
    </exclusiveGateway>
    <userTask id="T_Registrar" name="Registrar entradas/salidas de Excel">
      <incoming>Flow_25</incoming>
      <outgoing>Flow_26</outgoing>
      <dataOutputAssociation id="Assoc_36"><targetRef>DS_Inv</targetRef></dataOutputAssociation>
    </userTask>
    <endEvent id="E_FinBod" name="Fin">
      <incoming>Flow_26</incoming>
    </endEvent>
    <dataStoreReference id="DS_Inv" name="Inventarios - Excel" dataStoreRef="DS_DS_Inv"/>
    <sequenceFlow id="Flow_1" sourceRef="S_Nec" targetRef="T_Detectar"/>
    <sequenceFlow id="Flow_2" sourceRef="T_Detectar" targetRef="T_EnviarPedido"/>
    <sequenceFlow id="Flow_3" sourceRef="T_EnviarPedido" targetRef="T_RecibirSol"/>
    <sequenceFlow id="Flow_4" sourceRef="T_RecibirSol" targetRef="SP_Cotizar"/>
    <sequenceFlow id="Flow_5" sourceRef="SP_Cotizar" targetRef="G_Prov"/>
    <sequenceFlow id="Flow_6" name="sí" sourceRef="G_Prov" targetRef="T_SelProv"/>
    <sequenceFlow id="Flow_7" name="no" sourceRef="G_Prov" targetRef="SP_Cotizar"/>
    <sequenceFlow id="Flow_8" sourceRef="SP_Cotizar" targetRef="E_CotRec"/>
    <sequenceFlow id="Flow_9" sourceRef="E_CotRec" targetRef="T_RevEsp"/>
    <sequenceFlow id="Flow_10" sourceRef="T_RevEsp" targetRef="G_Esp"/>
    <sequenceFlow id="Flow_11" name="sí" sourceRef="G_Esp" targetRef="T_GenOC"/>
    <sequenceFlow id="Flow_12" name="no" sourceRef="G_Esp" targetRef="SP_Cotizar"/>
    <sequenceFlow id="Flow_13" sourceRef="SP_Cotizar" targetRef="T_Atender"/>
    <sequenceFlow id="Flow_14" sourceRef="T_Atender" targetRef="T_EnvCot"/>
    <sequenceFlow id="Flow_15" sourceRef="T_EnvCot" targetRef="SP_Cotizar"/>
    <sequenceFlow id="Flow_16" sourceRef="T_SelProv" targetRef="T_GenOC"/>
    <sequenceFlow id="Flow_17" sourceRef="T_GenOC" targetRef="T_Correl"/>
    <sequenceFlow id="Flow_18" sourceRef="T_Correl" targetRef="T_GuardarOC"/>
    <sequenceFlow id="Flow_19" sourceRef="T_GuardarOC" targetRef="T_RecOC"/>
    <sequenceFlow id="Flow_20" sourceRef="T_RecOC" targetRef="T_Despachar"/>
    <sequenceFlow id="Flow_21" sourceRef="T_Despachar" targetRef="T_MatRec"/>
    <sequenceFlow id="Flow_22" sourceRef="T_MatRec" targetRef="T_Verificar"/>
    <sequenceFlow id="Flow_23" sourceRef="T_Verificar" targetRef="G_Conforme"/>
    <sequenceFlow id="Flow_24" name="no" sourceRef="G_Conforme" targetRef="T_Despachar"/>
    <sequenceFlow id="Flow_25" name="sí" sourceRef="G_Conforme" targetRef="T_Registrar"/>
    <sequenceFlow id="Flow_26" sourceRef="T_Registrar" targetRef="E_FinBod"/>
    <sequenceFlow id="Flow_27" sourceRef="T_Despachar" targetRef="T_EnvFact"/>
    <sequenceFlow id="Flow_28" sourceRef="T_EnvFact" targetRef="T_FactRec"/>
    <sequenceFlow id="Flow_29" sourceRef="T_FactRec" targetRef="T_Transtecnia"/>
    <sequenceFlow id="Flow_30" sourceRef="T_Transtecnia" targetRef="E_FinCont"/>
    <group id="Fase_1" categoryValueRef="CV_Fase_1"/>
    <group id="Fase_2" categoryValueRef="CV_Fase_2"/>
    <group id="Fase_3" categoryValueRef="CV_Fase_3"/>
    <group id="Fase_4" categoryValueRef="CV_Fase_4"/>
    <group id="Fase_5" categoryValueRef="CV_Fase_5"/>
  </process>
  <dataStore id="DS_DS_Pedidos" name="Pedidos - Excel"/>
  <dataStore id="DS_DS_OC" name="PDF - Órdenes de compra"/>
  <dataStore id="DS_DS_Trans" name="Sistema Transtecnia"/>
  <dataStore id="DS_DS_Inv" name="Inventarios - Excel"/>
